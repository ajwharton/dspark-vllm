+_THINK_START = "<think>"
+_THINK_END = "</think>"
+
+# A tool call is an action, not reasoning. 0731 sometimes opens a <think> span
+# spontaneously (see ThinkBlockRouterParser) and then emits a tool call inside
+# it; routing that to `reasoning` hides it from the tool parser, which only
+# ever sees `content`, so the call is dropped and the raw DSML markup surfaces
+# in the client. Treat an opener as an implicit </think>.
+_TOOL_CALL_STARTS = ("<｜DSML｜tool_calls>", "<｜DSML｜function_calls>")
+
+
+def _route_think_blocks(
+    text: str, in_think: bool, holdback: bool
+) -> tuple[list[tuple[str, str]], bool, str]:
+    """Split `text` into ("reasoning"|"content", chunk) segments, routing the
+    inside of every <think>...</think> span to reasoning and stripping the
+    tags themselves. Tags may appear anywhere and any number of times; a
+    duplicate <think> while already thinking is stripped as a no-op.
+
+    Returns (segments, new_in_think, pending): with `holdback`, a trailing
+    substring that could still grow into a tag on the next streaming delta is
+    withheld and returned as `pending` instead of being emitted.
+    """
+    segments: list[tuple[str, str]] = []
+    pending = ""
+    while text:
+        i = text.find("<")
+        if i == -1:
+            segments.append(("reasoning" if in_think else "content", text))
+            return segments, in_think, pending
+        if i > 0:
+            segments.append(("reasoning" if in_think else "content", text[:i]))
+            text = text[i:]
+        if text.startswith(_THINK_END):
+            in_think = False
+            text = text[len(_THINK_END) :]
+        elif text.startswith(_THINK_START):
+            in_think = True
+            text = text[len(_THINK_START) :]
+        elif in_think and any(text.startswith(t) for t in _TOOL_CALL_STARTS):
+            # Implicit </think>: leave the opener in the text so it is emitted
+            # as content and the tool parser can pick the call up.
+            in_think = False
+        elif holdback and (
+            _THINK_START.startswith(text)
+            or _THINK_END.startswith(text)
+            or any(t.startswith(text) for t in _TOOL_CALL_STARTS)
+        ):
+            # The tail might complete into a tag with the next delta.
+            pending = text
+            return segments, in_think, pending
+        else:
+            # A lone "<" that is not (a prefix of) either tag: literal text.
+            segments.append(("reasoning" if in_think else "content", text[0]))
+            text = text[1:]
+    return segments, in_think, pending
+
+
+class ThinkBlockRouterParser(ReasoningParser):
+    """Routes EVERY <think>...</think> span to `reasoning`, wherever it
+    appears in the output, and never leaks the tags into `content`.
+
+    Why this exists: the stock delegation (R1 parser for thinking mode,
+    Identity otherwise) assumes at most one reasoning block at the very
+    start of the output. DS4-Flash-0731 is agent-tuned and at temperature
+    1.0 (on 2-bit-flattened logits) it occasionally REOPENS a <think>
+    block mid-answer, or opens one spontaneously with thinking disabled —
+    both leak raw "</think>" text to clients (observed in OpenCode,
+    2026-08-06). This parser is state-driven, purely text-based (robust
+    to arbitrary token chunking, e.g. multi-token speculative deltas) and
+    handles any number of blocks in both modes.
+
+    `initial_in_think=True` models a chat template that pre-filled
+    <think> (thinking mode); an explicit leading <think> in the output is
+    stripped as a duplicate either way.
+    """
+
+    def __init__(
+        self,
+        tokenizer: PreTrainedTokenizerBase,
+        *args,
+        initial_in_think: bool = False,
+        **kwargs,
+    ):
+        super().__init__(tokenizer, *args, **kwargs)
+        self._initial_in_think = initial_in_think
+        self._in_think = initial_in_think
+        self._pending = ""
+        # Separate state for the post-latch (late) content pass.
+        self._late_in_think = False
+        self._late_pending = ""
+
+    @property
+    def reasoning_start_str(self) -> str | None:
+        return _THINK_START
+
+    @property
+    def reasoning_end_str(self) -> str | None:
+        return _THINK_END
+
+    def is_reasoning_end(self, input_ids: Sequence[int]) -> bool:
+        return not self._in_think
+
+    def is_reasoning_end_streaming(
+        self, input_ids: Sequence[int], delta_ids: Iterable[int]
+    ) -> bool:
+        return not self._in_think
+
+    def extract_content_ids(self, input_ids: list[int]) -> list[int]:
+        # Identity approximation: structured-output constraining over the
+        # exact content span is not distinguishable here without a second
+        # detokenization pass; matches the pre-existing non-think behavior.
+        return input_ids
+
+    def extract_reasoning_streaming(
+        self,
+        previous_text: str,
+        current_text: str,
+        delta_text: str,
+        previous_token_ids: Sequence[int],
+        current_token_ids: Sequence[int],
+        delta_token_ids: Sequence[int],
+    ) -> DeltaMessage | None:
+        if not delta_text and not self._pending:
+            return None
+        segments, self._in_think, self._pending = _route_think_blocks(
+            self._pending + delta_text, self._in_think, holdback=True
+        )
+        reasoning = "".join(t for k, t in segments if k == "reasoning")
+        content = "".join(t for k, t in segments if k == "content")
+        if not reasoning and not content:
+            return None
+        return DeltaMessage(
+            reasoning=reasoning or None, content=content or None
+        )
+
+    def extract_reasoning(
+        self, model_output: str, request: "ChatCompletionRequest | ResponsesRequest"
+    ) -> tuple[str | None, str | None]:
+        segments, _, _ = _route_think_blocks(
+            model_output, self._initial_in_think, holdback=False
+        )
+        reasoning = "".join(t for k, t in segments if k == "reasoning")
+        content = "".join(t for k, t in segments if k == "content")
+        return reasoning or None, content if content else None
+
+    def route_late_content(
+        self, text: str, *, finished: bool
+    ) -> tuple[str | None, str | None]:
+        """Route <think> blocks found in content AFTER the reasoning phase.
+
+        DelegatingParser latches `reasoning_ended` one-way: once the
+        reasoning phase closes (immediately, at prompt inspection, when
+        thinking is disabled), the reasoning parser is never consulted
+        again and everything flows through the tool parser / passthrough.
+        Agent-tuned checkpoints do reopen <think> mid-answer, so without a
+        late pass those blocks reach the client verbatim.
+
+        Keeps state separate from the reasoning-phase machine (that one
+        stopped at the latch) and holds back a partial tag until the next
+        delta; `finished` flushes it.
+        """
+        segments, self._late_in_think, self._late_pending = _route_think_blocks(
+            self._late_pending + text, self._late_in_think, holdback=not finished
+        )
+        reasoning = "".join(t for k, t in segments if k == "reasoning")
+        content = "".join(t for k, t in segments if k == "content")
+        if finished and self._late_pending:
+            content += self._late_pending
+            self._late_pending = ""
+        return reasoning or None, content or None
+
 
